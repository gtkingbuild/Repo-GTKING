# --- 1.6.0: per-engine port and detection of which one answers ---
# NOTE: 30059 has been skipped since 1.5.0, do not reuse it.

msgctxt "#30087"
msgid "AceServe engine port (empty = same as AceStream)"
msgstr "Puerto de AceServe (vacío = el de AceStream)"

msgctxt "#30088"
msgid "%s is answering on port %s. Check the Ace Engine setting."
msgstr "Contesta %s en el puerto %s. Revisa el ajuste Motor ace."

msgctxt "#30089"
msgid "Something that is not the ace engine is listening on port %s.\n\nBoth engines use the same port, and whichever starts second cannot open it. Close the other application and try again."
msgstr "En el puerto %s hay algo escuchando que no es el motor ace.\n\nLos dos motores usan el mismo puerto y el que arranca en segundo lugar no puede abrirlo. Cierra la otra aplicación e inténtalo de nuevo."

msgctxt "#30090"
msgid "Opening the engine. Come back to Kodi once it has started."
msgstr "Abriendo el motor. Vuelve a Kodi cuando haya arrancado."

msgctxt "#30091"
msgid "The ace engine could not be opened.\n\nIf you do not have it installed, you will find AceStream and AceServe in the Download APKs menu."
msgstr "No se ha podido abrir el motor ace.\n\nSi no lo tienes instalado, en el menú Descargar APKs tienes AceStream y AceServe."

# --- 1.6.0: control panel ---

msgctxt "#30092"
msgid "Control panel"
msgstr "Cuadro de mandos"

msgctxt "#30093"
msgid "Choose the engine, change its address and port, switch the external player on or off, and see live which engine is answering."
msgstr "Elige el motor, cambia su dirección y su puerto, enciende o apaga el reproductor externo y mira en vivo qué motor está contestando."

msgctxt "#30094"
msgid "EKHorus guide"
msgstr "Guía de EKHorus"

msgctxt "#30095"
msgid "The complete guide to EKHorus, AceStream and AceServe: read it here or open it in your browser."
msgstr "La guía completa de EKHorus, AceStream y AceServe: léela aquí mismo o ábrela en el navegador."
