# --- APK download menu and EspaKodi addons menu (ported from 1.3.5) ---
# NOTE: in 1.3.5 these labels used 30048-30052, which here are already the history
# context menu and the engine download error. They are renumbered to 30082+

msgctxt "#30053"
msgid "Choose the folder to save %s"
msgstr "Elige la carpeta donde guardar %s"

msgctxt "#30054"
msgid "Downloading %s..."
msgstr "Descargando %s..."

msgctxt "#30055"
msgid "APK downloaded to:\n%s\n\nTo install it:\n1) Open a file manager on your device (on Fire TV, the \"Downloader\" app; on mobile, \"Files\" or \"My Files\").\n2) Go to that folder and tap the APK.\n3) If Android asks for permission to install unknown apps, grant it to THAT app (the file manager), not to Kodi."
msgstr "APK descargado en:\n%s\n\nPara instalarlo:\n1) Abre un gestor de archivos de tu dispositivo (en Fire TV, la app \"Downloader\"; en móvil, \"Archivos\" o \"Mis archivos\").\n2) Entra en la carpeta indicada y pulsa el APK.\n3) Si Android pide permiso para instalar apps de origen desconocido, concédeselo a ESA app (el gestor de archivos), no a Kodi."

msgctxt "#30056"
msgid "%s already exists in that folder.\n\nDo you want to download it again and overwrite it?"
msgstr "%s ya existe en esa carpeta.\n\n¿Quieres descargarlo de nuevo y sobrescribirlo?"

msgctxt "#30057"
msgid "Download cancelled"
msgstr "Descarga cancelada"

msgctxt "#30058"
msgid "%s could not be downloaded.\n\n%s"
msgstr "No se ha podido descargar %s.\n\n%s"

msgctxt "#30060"
msgid "%s\n\nThis file is an Android installer (APK), so it can only be installed on Android devices (Fire TV, Android TV, phones...).\n\nIt has been saved to:\n%s"
msgstr "%s\n\nEste archivo es un instalador de Android (APK), así que solo se puede instalar en dispositivos Android (Fire TV, Android TV, móviles...).\n\nSe ha guardado en:\n%s"

msgctxt "#30061"
msgid "Install now"
msgstr "Instalar ahora"

msgctxt "#30062"
msgid "Install manually (any device)"
msgstr "Instalar a mano (cualquier dispositivo)"

msgctxt "#30063"
msgid "Open unknown sources settings"
msgstr "Abrir ajustes de orígenes desconocidos"

msgctxt "#30064"
msgid "Close"
msgstr "Cerrar"

msgctxt "#30065"
msgid "EKHorus: installation"
msgstr "EKHorus: instalación"

msgctxt "#30066"
msgid "Preparing the APK for the installer..."
msgstr "Preparando el APK para el instalador..."

msgctxt "#30067"
msgid "Cannot write to this folder:\n%s\n\nChoose another one."
msgstr "No se puede escribir en esta carpeta:\n%s\n\nElige otra."

msgctxt "#30068"
msgid "Install now (root / Kodi as a system app)"
msgstr "Instalar ahora (root / Kodi como app de sistema)"

msgctxt "#30069"
msgid "APK installed successfully."
msgstr "APK instalado correctamente."

msgctxt "#30070"
msgid "It could not be installed automatically: this requires root or Kodi running as a system app.\n\nInstall it manually from a file manager instead."
msgstr "No se ha podido instalar automáticamente: hace falta root o que Kodi sea una app de sistema.\n\nInstálalo a mano desde un gestor de archivos."

msgctxt "#30071"
msgid "%s is already being downloaded"
msgstr "Ya se está descargando %s"

msgctxt "#30072"
msgid "Could not write to disk. The device may be out of free space."
msgstr "No se ha podido escribir en el disco. Puede que no quede espacio libre en el dispositivo."

msgctxt "#30073"
msgid "%s could not be prepared for the installer.\n\n%s"
msgstr "No se ha podido preparar %s para el instalador.\n\n%s"

msgctxt "#30074"
msgid "[COLOR yellow]Careful, these APKs are 32-bit[/COLOR] - press for more information"
msgstr "[COLOR yellow]Ojo, estos APK son de 32 bits[/COLOR] - pulsa para más información"

msgctxt "#30075"
msgid "All the APKs on this list are 32-bit (armeabi-v7a). This menu and these builds are meant for devices like the Fire TV Stick or TV boxes, where installing things and moving files across is a hassle (no USB, no ADB, no transferring from your phone).\n\nMost of these devices, even 64-bit ones, install and run 32-bit apps without any issue; only a few newer devices have dropped 32-bit support entirely. The easiest way to check is to just try installing it. If the system won't let you, that's your device telling you it's 64-bit only, and you'll need the 64-bit version from these links\n\n- EspaKodi on Telegram https://t.me/espakodi\n- https://espakodi.github.io/apk/"
msgstr "Mucho Udyat: todos los APK de esta lista son de 32 bits (armeabi-v7a); este menú y estas versiones están pensados para aparatos como el Fire TV Stick o los TV box, donde instalar cosas y pasarles archivos es un engorro (nada de USB, ni ADB, ni transferir desde el móvil).\n\nLa inmensa mayoría de estos dispositivos, aunque sean de 64 bits, instalan y ejecutan sin problema apps de 32 bits; solo algunos aparatos muy modernos han dejado de soportarlo del todo. La forma más fácil de comprobarlo es probar a instalarlo. Si el sistema no te deja, es señal de que tu dispositivo es solo de 64 bits y tendrás que buscar la versión de 64 bits en estos enlaces\n\n- Telegram de EspaKodi https://t.me/espakodi\n- https://espakodi.github.io/apk/"

msgctxt "#30076"
msgid "Download again"
msgstr "Descargar de nuevo"

msgctxt "#30077"
msgid "Use the existing one"
msgstr "Usar el que ya está"

msgctxt "#30078"
msgid "The copy of %s you already had is damaged or incomplete.\n\nIt will be downloaded again."
msgstr "El %s que ya tenías está dañado o incompleto.\n\nSe va a descargar de nuevo."

msgctxt "#30079"
msgid "%s finished downloading, but the file is damaged or incomplete.\n\nPlease try again."
msgstr "%s ha terminado de descargarse, pero el archivo está dañado o incompleto.\n\nInténtalo de nuevo."

msgctxt "#30080"
msgid "%s downloaded correctly, but it could not be saved into the chosen folder.\n\nTry another folder."
msgstr "%s se ha descargado bien, pero no se ha podido guardar en la carpeta elegida.\n\nPrueba con otra carpeta."

